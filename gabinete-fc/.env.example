# ============================================================
# GABINETE FC — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local (dev) ou configure na Vercel (prod).
# NUNCA commite o .env real.

# ─── BANCO DE DADOS (Supabase Postgres) ────────────────────────
# Pegue em: Supabase Dashboard → Settings → Database → Connection string → URI
# Use o "Transaction" pooler (porta 6543) para serverless
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL é só pra migrations (porta 5432, sem pooler)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── SUPABASE AUTH ─────────────────────────────────────────────
# Settings → API → Project URL + anon/service_role keys
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://gabinetefc.com.br"
NEXT_PUBLIC_APP_NAME="Gabinete FC"

# ─── STRIPE (LIVE) ─────────────────────────────────────────────
# Dashboard Stripe → Developers → API keys (modo LIVE no canto sup. direito)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Webhook secret: criar webhook em https://seu-dominio/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── CORREIOS CWS (rastreio + frete real) ──────────────────────
CORREIOS_USERNAME=""
CORREIOS_PASSWORD=""
CORREIOS_CEP_ORIGEM="01310100"

# ─── CRON (Vercel) ─────────────────────────────────────────────
# Gere com: openssl rand -base64 32
CRON_SECRET=""

# ─── OPCIONAIS (configurar depois do lançamento) ───────────────
# Meta Pixel + CAPI
NEXT_PUBLIC_META_PIXEL_ID=""
META_ACCESS_TOKEN=""
# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@gabinetefc.com.br"
