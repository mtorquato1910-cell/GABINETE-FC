# ============================================================
# GABINETE FC — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local (dev) ou configure na Vercel (prod).
# NUNCA commite o .env real.

# ─── BANCO DE DADOS (Supabase Postgres) ────────────────────────
# Pegue em: Supabase Dashboard → Settings → Database → Connection string → URI
# Use o "Transaction" pooler (porta 6543) para serverless
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL é só pra migrations (porta 5432, sem pooler)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── SUPABASE AUTH ─────────────────────────────────────────────
# Settings → API → Project URL + anon/service_role keys
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://gabinetefc.com.br"
NEXT_PUBLIC_APP_NAME="Gabinete FC"

# ─── INFINITY PAY (Checkout Integrado) — gateway atual ────────
# Doc: https://www.infinitepay.io/checkout-documentacao
# Autenticação 100% via handle no body. SEM API key. SEM webhook secret.
# Validação anti-fraude do webhook via callback POST /payment_check.
INFINITEPAY_HANDLE="seu-handle-aqui"  # InfiniteTag sem $, ex: gabriel-calheiros-u95
INFINITEPAY_API_URL="https://api.checkout.infinitepay.io"

# ─── STRIPE (LEGADO) ───────────────────────────────────────────
# Mantido por 30 dias após migração Infinity Pay (rollback safety, deletar em 2026-06-26).
# Em produção, deixar essas envs vazias é o esperado — o código não usa mais.
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ─── CORREIOS CWS (rastreio + frete real) ──────────────────────
CORREIOS_USERNAME=""
CORREIOS_PASSWORD=""
CORREIOS_CEP_ORIGEM="01310100"

# ─── CRON (Vercel) ─────────────────────────────────────────────
# Gere com: openssl rand -base64 32
CRON_SECRET=""

# ─── GOOGLE TAG MANAGER ────────────────────────────────────────
# Container ID do GTM. Snippet (head + noscript body) é injetado
# automaticamente pelo layout.tsx quando esta variável está setada.
NEXT_PUBLIC_GTM_ID="GTM-NH6RDVXV"

# ─── OPCIONAIS (configurar depois do lançamento) ───────────────
# Meta Pixel + CAPI
NEXT_PUBLIC_META_PIXEL_ID=""
META_ACCESS_TOKEN=""
# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@gabinetefc.com.br"
