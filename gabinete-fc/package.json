    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-inner-image-zoom": "^4.0.1",
    "resend": "^6.12.0",
    "shadcn": "^4.3.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
